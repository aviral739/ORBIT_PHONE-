package core.decision

import java.time.Instant

/**
 * Represents an incoming event in the ORBIT system.
 * Matches the shared ORBIT Event contract.
 */
data class Event(
    val id: String,
    val source: EventSource,
    val type: String,
    val text: String,
    val timestamp: Instant,
    val metadata: Map<String, String> = emptyMap()
) {
    init {
        require(id.isNotBlank()) { "Event ID must not be blank" }
        require(type.isNotBlank()) { "Event type must not be blank" }
    }
}

/**
 * Enum of supported event sources per the ORBIT contract.
 */
enum class EventSource {
    VOICE,
    NOTIFICATION,
    CAMERA,
    MANUAL,
    SIMULATOR
}

/**
 * Result of scoring an event. Contains individual dimension scores
 * and an overall composite score.
 *
 * This is the output of EventScorer and input to DecisionEngine.
 * EventScorer does NOT decide DROP/COMPRESS/QUEUE/REASON.
 */
data class ScoringResult(
    val eventId: String,
    val overallScore: Double,
    val relevance: Double,
    val urgency: Double,
    val novelty: Double,
    val contextChange: Double,
    val confidence: Double,
    val scoringContext: ScoringContext
) {
    init {
        require(overallScore in 0.0..1.0) { "Overall score must be between 0.0 and 1.0" }
        require(relevance in 0.0..1.0) { "Relevance must be between 0.0 and 1.0" }
        require(urgency in 0.0..1.0) { "Urgency must be between 0.0 and 1.0" }
        require(novelty in 0.0..1.0) { "Novelty must be between 0.0 and 1.0" }
        require(contextChange in 0.0..1.0) { "Context change must be between 0.0 and 1.0" }
        require(confidence in 0.0..1.0) { "Confidence must be between 0.0 and 1.0" }
        require(eventId.isNotBlank()) { "Event ID must not be blank" }
    }
}

/**
 * Optional context provided to the scorer for computing novelty
 * and context change signals.
 */
data class ScoringContext(
    val priorEvents: List<Event> = emptyList(),
    val currentTopicSummaries: List<String> = emptyList()
)

/**
 * Deterministic EventScorer that evaluates event significance
 * across four dimensions: relevance, urgency, novelty, contextChange,
 * plus a heuristic confidence measure.
 *
 * The scorer does NOT make decision-state selections (DROP/COMPRESS/QUEUE/REASON).
 * Those decisions belong to DecisionEngine.
 *
 * Weights are centralized, documented, and sum to 1.0 for the composite score.
 *
 * IMPORTANT: All scoring is heuristic and deterministic. No semantic understanding
 * or calibrated probabilities are claimed. Novelty uses lexical (Jaccard) similarity.
 * Confidence is a heuristic evidence score, not a probability.
 */
class EventScorer {

    companion object {
        /**
         * Weights for the four composite scoring dimensions.
         * These sum to 1.0 and are documented here for transparency.
         * Adjusting these should be done centrally.
         */
        const val WEIGHT_RELEVANCE = 0.30
        const val WEIGHT_URGENCY = 0.30
        const val WEIGHT_NOVELTY = 0.20
        const val WEIGHT_CONTEXT_CHANGE = 0.20

        /**
         * Urgency keywords with individual weights.
         * Using a map to avoid double-counting related terms.
         * Simple string matching - no NLP framework.
         */
        private val URGENCY_KEYWORDS = mapOf(
            "deadline" to 0.25,
            "due" to 0.20,
            "urgent" to 0.30,
            "asap" to 0.35,
            "immediately" to 0.30,
            "now" to 0.15,
            "today" to 0.25,
            "tomorrow" to 0.20,
            "overdue" to 0.40,
            "emergency" to 0.45,
            "critical" to 0.35,
            "expiration" to 0.20,
            "expires" to 0.20,
            "reschedule" to 0.20,
            "moved up" to 0.25,
            "earlier" to 0.15,
            "sooner" to 0.15
        )

        /**
         * Context-change keywords with weights.
         * Indicates meaningful change to existing context.
         */
        private val CONTEXT_CHANGE_KEYWORDS = mapOf(
            "changed" to 0.20,
            "updated" to 0.25,
            "moved" to 0.30,
            "rescheduled" to 0.35,
            "modified" to 0.20,
            "corrected" to 0.25,
            "revised" to 0.25,
            "cancelled" to 0.40,
            "postponed" to 0.30,
            "delayed" to 0.25,
            "new date" to 0.35,
            "new time" to 0.35,
            "instead" to 0.15,
            "rather than" to 0.15
        )

        /**
         * Event types that strongly indicate productivity relevance.
         */
        private val HIGH_RELEVANCE_TYPES = setOf(
            "task", "deadline", "meeting", "calendar",
            "reminder", "commitment", "appointment", "schedule"
        )

        /**
         * Source base relevance scores.
         * MANUAL is highest because user explicitly entered it.
         */
        private val SOURCE_RELEVANCE = mapOf(
            EventSource.MANUAL to 0.50,
            EventSource.NOTIFICATION to 0.40,
            EventSource.CAMERA to 0.35,
            EventSource.VOICE to 0.35,
            EventSource.SIMULATOR to 0.20
        )

        /**
         * Maximum contribution from text content (not length alone).
         * Content signals: presence of actionable keywords, dates, times.
         */
        private const val MAX_CONTENT_RELEVANCE = 0.25
        private const val MAX_URGENCY_SCORE = 1.0
        private const val MAX_CONTEXT_CHANGE_SCORE = 1.0
    }

    /**
     * Scores an event and returns a detailed ScoringResult.
     *
     * @param event The event to score
     * @param context Optional scoring context for novelty/context-change
     * @return ScoringResult with all dimension scores
     */
    fun score(event: Event, context: ScoringContext = ScoringContext()): ScoringResult {
        val rel = computeRelevance(event)
        val urg = computeUrgency(event)
        val nov = computeNovelty(event, context)
        val ctxChange = computeContextChange(event)
        val conf = computeConfidence(event, rel, urg, nov, ctxChange)

        val overall = (rel * WEIGHT_RELEVANCE +
                       urg * WEIGHT_URGENCY +
                       nov * WEIGHT_NOVELTY +
                       ctxChange * WEIGHT_CONTEXT_CHANGE).coerceIn(0.0, 1.0)

        return ScoringResult(
            eventId = event.id,
            overallScore = overall,
            relevance = rel,
            urgency = urg,
            novelty = nov,
            contextChange = ctxChange,
            confidence = conf,
            scoringContext = context
        )
    }

    /**
     * Relevance: How pertinent is this event to the user's productivity?
     *
     * Combines:
     * - Source reliability (user-entered > notifications > camera/voice > simulator)
     * - Event type signals (task/deadline/meeting/calendar)
     * - Text content quality (actionable keywords, not just length)
     */
    private fun computeRelevance(event: Event): Double {
        var score = 0.0

        // Source-based relevance
        score += SOURCE_RELEVANCE[event.source] ?: 0.2

        // Type-based relevance
        val typeLower = event.type.lowercase()
        if (HIGH_RELEVANCE_TYPES.any { typeLower.contains(it) }) {
            score += 0.20
        }

        // Content-based relevance: look for actionable signals, not just length
        val textLower = event.text.lowercase().trim()
        var contentScore = 0.0

        // Actionable keywords
        if (textLower.contains(Regex("\\b(deadline|due|meeting|task|remind|schedule|appointment)\\b"))) {
            contentScore += 0.10
        }
        // Time/date references
        if (textLower.contains(Regex("\\b\\d{1,2}:\\d{2}\\s*(am|pm)?\\b")) ||
            textLower.contains(Regex("\\b(today|tomorrow|this\\s+week|next\\s+week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b"))) {
            contentScore += 0.10
        }
        // Non-trivial content
        if (textLower.length > 20) {
            contentScore += 0.05
        }

        score += contentScore.coerceAtMost(MAX_CONTENT_RELEVANCE)

        return score.coerceIn(0.0, 1.0)
    }

    /**
     * Urgency: Does this event require timely attention?
     *
     * Uses weighted keyword matching with diminishing returns to avoid
     * double-counting related terms. Also considers explicit time references
     * and deadline-type events.
     */
    private fun computeUrgency(event: Event): Double {
        val textLower = event.text.lowercase()
        var score = 0.0

        // Weighted keyword matching - each keyword contributes its weight
        // but total is capped to prevent saturation from related terms
        for ((keyword, weight) in URGENCY_KEYWORDS) {
            if (textLower.contains(keyword)) {
                score += weight
            }
        }

        // Time/date pattern detection adds additional urgency
        val hasExplicitTime = textLower.contains(Regex("\\b\\d{1,2}:\\d{2}\\s*(am|pm)?\\b"))
        val hasExplicitDay = textLower.contains(Regex("\\b(today|tomorrow|this\\s+week|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b"))
        if (hasExplicitTime) score += 0.20
        if (hasExplicitDay) score += 0.15

        // Deadline type explicitly mentioned
        if (typeLowerContainsAny(event.type, setOf("deadline", "due"))) {
            score += 0.25
        }

        return score.coerceIn(0.0, MAX_URGENCY_SCORE)
    }

    /**
     * Novelty: How new/different is this event compared to prior events?
     *
     * Uses lexical Jaccard similarity on word tokens.
     * LIMITATION: This is purely lexical, not semantic similarity.
     * "Meeting moved to 3pm" and "Meeting moved to 5pm" will appear similar
     * lexically even though the time change is semantically significant.
     * ContextChange scoring captures the semantic change separately.
     */
    private fun computeNovelty(event: Event, context: ScoringContext): Double {
        if (context.priorEvents.isEmpty()) {
            return 1.0 // No prior context - treat as fully novel
        }

        val eventTokens = tokenize(event.text)
        if (eventTokens.isEmpty()) return 0.5

        var maxSimilarity = 0.0
        for (prior in context.priorEvents) {
            val priorTokens = tokenize(prior.text)
            if (priorTokens.isEmpty()) continue

            val intersection = eventTokens.intersect(priorTokens).size
            val union = eventTokens.union(priorTokens).size
            val similarity = if (union > 0) intersection.toDouble() / union else 0.0
            maxSimilarity = maxOf(maxSimilarity, similarity)
        }

        // Novelty is inverse of max similarity
        return (1.0 - maxSimilarity).coerceIn(0.0, 1.0)
    }

    /**
     * Context Change: Does this event indicate a meaningful change
     * to existing context (reschedule, update, correction)?
     *
     * Detects change language and type signals separately.
     * "Meeting moved from 3 PM to 5 PM" scores high on both
     * change keywords and type signals.
     */
    private fun computeContextChange(event: Event): Double {
        val textLower = event.text.lowercase()
        var score = 0.0

        // Weighted keyword matching
        for ((keyword, weight) in CONTEXT_CHANGE_KEYWORDS) {
            if (textLower.contains(keyword)) {
                score += weight
            }
        }

        // Type-based signal
        if (typeLowerContainsAny(event.type, setOf("change", "update", "modify", "reschedule"))) {
            score += 0.30
        }

        return score.coerceIn(0.0, MAX_CONTEXT_CHANGE_SCORE)
    }

    /**
     * Confidence: Heuristic evidence score for the scoring interpretation.
     *
     * NOT a calibrated probability. Reflects:
     * - Text availability and content quality
     * - Source reliability
     * - Number of active scoring signals
     */
    private fun computeConfidence(
        event: Event,
        relevance: Double,
        urgency: Double,
        novelty: Double,
        contextChange: Double
    ): Double {
        var score = 0.0

        // Text availability and content quality
        val text = event.text.trim()
        when {
            text.isEmpty() -> score += 0.0
            text.length < 10 -> score += 0.10
            text.length < 50 -> score += 0.25
            else -> score += 0.40
        }

        // Source reliability
        score += when (event.source) {
            EventSource.MANUAL -> 0.20
            EventSource.NOTIFICATION -> 0.15
            EventSource.CAMERA -> 0.10
            EventSource.VOICE -> 0.10
            EventSource.SIMULATOR -> 0.05
        }

        // Signal coherence - multiple active dimensions increase confidence
        val signals = listOf(relevance, urgency, novelty, contextChange)
        val activeSignals = signals.count { it > 0.15 }
        score += (activeSignals * 0.05).coerceAtMost(0.20)

        return score.coerceIn(0.0, 1.0)
    }

    /**
     * Checks if the event type contains any of the given keywords.
     */
    private fun typeLowerContainsAny(type: String, keywords: Set<String>): Boolean {
        val lower = type.lowercase()
        return keywords.any { lower.contains(it) }
    }

    /**
     * Simple word tokenization for lexical similarity.
     * Splits on non-word characters, filters empty strings.
     */
    private fun tokenize(text: String): Set<String> =
        text.lowercase().split(Regex("\\W+")).filter { it.isNotBlank() }.toSet()
}